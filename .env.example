NODE_ENV=development
PORT=3000

# PostgreSQL pada server node1. Nilai ini adalah hostname yang dapat dijangkau dari lokal.
DB_HOST=node1-ali.masitech.net
DB_PORT=5432
DB_NAME=umkm_gear_prototipe1
DB_ADMIN_NAME=postgres
DB_USER=postgres
DB_PASSWORD=ganti_dengan_password_postgres
DB_SSL=false

# Ganti dengan string acak panjang sebelum digunakan di luar development.
JWT_SECRET=ganti-dengan-random-secret-minimal-32-karakter
JWT_EXPIRES_IN=8h
